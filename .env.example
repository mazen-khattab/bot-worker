# --- Server ---
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# --- Security ---
# Shared secret the .NET backend must send in the X-Worker-Api-Key header
# Generate with: openssl rand -hex 32
WORKER_API_KEY=

# --- .NET backend integration ---
DOTNET_API_URL=https://api.naafez.com
# Use the key accepted by your backend's worker callback endpoints.
# Both directions use the X-Worker-Api-Key header.
DOTNET_API_KEY=

# --- Concurrency ---
MAX_CONCURRENT_SESSIONS=3

# --- Idempotency (Job Queue) ---
IDEMPOTENCY_TTL_HOURS=24

# --- Dead Letter Queue (failed .NET callbacks) ---
DLQ_FILE_PATH=./data/dlq.json
DLQ_SYNC_INTERVAL_MS=60000

# --- Screenshots on error ---
SCREENSHOT_DIR=./screenshots
SCREENSHOT_RETENTION_DAYS=7
